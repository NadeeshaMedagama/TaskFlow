# copy this to .env and fill in real values -- never commit the real .env

# --- Application configuration ---------------------------------------------
# These are passed straight into the API container via compose `env_file`,
# and DB_USER / DB_PASSWORD / DB_NAME are also interpolated into the Postgres
# service so both halves can never drift apart.
DB_HOST=taskflow-db
DB_PORT=5432
DB_USER=taskflow
DB_PASSWORD=changeme
DB_NAME=taskflow
REDIS_HOST=taskflow-cache
REDIS_PORT=6379
PORT=4000

# --- Image naming (Part 6) -------------------------------------------------
# Used only by Compose interpolation and scripts/build-images.sh to tag the
# two images we build. Both have built-in defaults, so the stack runs without
# them; set REGISTRY_NAMESPACE to your own Docker Hub user (or ghcr.io/<user>)
# before you push anywhere -- the default below is a local placeholder that a
# registry will reject.
#
# Note these also land in the API container, since compose feeds this whole
# file to it. Harmless, but that is why they are named distinctly.
REGISTRY_NAMESPACE=taskflow
TASKFLOW_VERSION=1.0.0
